# Base de datos (Prisma)
DATABASE_URL="postgresql://usuario:password@localhost:5432/turnos?schema=public"

# SMTP para el envio de mails con nodemailer
# Ejemplo con Gmail: host smtp.gmail.com, puerto 587, y usar una "contraseña de aplicacion",
# no la contraseña normal de la cuenta.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="tu-cuenta@gmail.com"
SMTP_PASS="tu-contraseña-de-aplicacion"
SMTP_FROM="tu-cuenta@gmail.com"
