generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Turno {
  id           String   @id @default(cuid())

  nombre       String
  telefono     String
  obraSocial   String?
  motivo       String
  antecedentes String?
  comentario   String?

  primeraVez   Boolean
  sesiones     Int

  fechas       Json

  estado       String   @default("pendiente") // pendiente | confirmado | cancelado

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([telefono])
  @@index([createdAt])
}
